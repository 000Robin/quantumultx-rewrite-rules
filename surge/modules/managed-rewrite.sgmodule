#!name=Robin Surge 去广重写
#!desc=由仓库 Quantumult X 重写独立转换；使用 Surge 原生请求/响应脚本与精确 MitM。
#!author=000Robin
#!homepage=https://github.com/000Robin/quantumultx-rewrite-rules
#!date=2026-10-01

[Rule]
# Static advertising transports and media.
URL-REGEX,^https?:\/\/iacc(?:\.rec)?\.qq\.com\/.*,REJECT
URL-REGEX,^https:\/\/vfiles\.gtimg\.cn\/wupload\/xy\/starter\/(?!(?:FNLQm0lJ|PxESsWQr|NdBbLdGV|U0wi0Z26|g1qIyxoO)\.png(?:\?|$)).*,REJECT-TINYGIF
URL-REGEX,^https:\/\/(?:vfiles\.gtimg\.cn|vip\.image\.video\.qpic\.cn)\/wupload\/xy\/promotionTest\/.*,REJECT
URL-REGEX,^https:\/\/wa\.gtimg\.com\/adxcdn\/.*\.(?:jpe?g|png|gif|webp)(?:\?.*)?$,REJECT-TINYGIF
URL-REGEX,^https:\/\/wallpaper-1258344696\.file\.myqcloud\.com\/hikari\/module\/[^/?]*reward-ad[^/?]*\.zip(?:\?.*)?$,REJECT
URL-REGEX,^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/.*$,REJECT
URL-REGEX,^https:\/\/sf3-be-pack\.pglstatp-toutiao\.com\/obj\/ad-app-package\/.*$,REJECT
URL-REGEX,^https:\/\/v(?:3|5|6|9)-novelapp\.fqnovelvod\.com\/.*\/video\/.*$,REJECT
URL-REGEX,^https:\/\/v(?:3|5|9)-reading-video\.fqnovelvod\.com\/.*$,REJECT
URL-REGEX,^https:\/\/storage-public\.zhaopin\.cn\/information\/team\/public\/.*(?:2000x1080|1080x2000|1290x2796|2796x1290|1179x2556|2556x1179).*,REJECT
URL-REGEX,^https?:\/\/autoload\.bank\.ecitic\.com\/imcslego\/cloud\/[^?]+\.(?:png|jpg|jpeg|gif|webp)\?[^#]*(?:width=750&height=1624|height=1624&width=750)(?:&.*)?$,REJECT-TINYGIF
URL-REGEX,^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/scjson\/tripAds,REJECT
URL-REGEX,^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=start(?:&|$).*,REJECT
URL-REGEX,^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:queryMaterialAdverts|home_launchConfig|getWidgetV1052)(?:&|$).*,REJECT

[Script]
tencent-video-verified-creative = type=http-request,pattern=^https:\/\/svv\.video\.qq\.com\/getvinfo(?:\?.*)?$,requires-body=true,max-size=65536,script-path=https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/surge/scripts/tencent_video_creative_block.js
tencent-video-request = type=http-request,pattern=^https:\/\/i\.video\.qq\.com\/(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=1048576,engine=webview,script-path=https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/surge/scripts/tencent_video_request_clean.js
tencent-video-response = type=http-response,pattern=^https:\/\/i\.video\.qq\.com\/(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,engine=webview,script-path=https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/surge/scripts/tencent_video_popup_clean.js
