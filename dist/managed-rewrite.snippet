#!name=Robin 个人维护去开屏
#!desc=腾讯视频、YouTube、番茄小说与 12306 等已验证广告接口净化；仅供 000Robin 个人使用。
#!author=000Robin
#!homepage=https://github.com/000Robin/quantumultx-rewrite-rules
#!date=2026-09-01

# Tencent Video startup/interactive ad transport and media
^https?:\/\/iacc(?:\.rec)?\.qq\.com\/.* url reject-200
^https:\/\/vfiles\.gtimg\.cn\/wupload\/xy\/starter\/.* url reject
^https:\/\/(?:vfiles\.gtimg\.cn|vip\.image\.video\.qpic\.cn)\/wupload\/xy\/promotionTest\/.* url reject

# Tencent Video in-app popup/ad cards; exact root endpoint only.
^https:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_popup_clean.js

# Tencent Video pause-ad image confirmed by 2026-08-31 HAR; keep the scope on the ad-exchange CDN path.
^https:\/\/wa\.gtimg\.com\/adxcdn\/.*\.(?:jpe?g|png|gif|webp)(?:\?.*)?$ url reject-img

# YouTube ads: exact API host and content endpoints; no googlevideo playback MitM.
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/youtube_ad_clean.js

# Fanqie Novel safe ad blocking: Pangle ad manifest and explicit ad assets only.
# Do not intercept fqnovelvod, generic snssdk, gurd or zijieapi traffic; those can break audiobook or verification.
^https:\/\/api-access\.pangolin-sdk-toutiao(?:[1-5]|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/?(?:\?.*)?$ url reject-dict
^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/.*$ url reject
^https:\/\/sf3-be-pack\.pglstatp-toutiao\.com\/obj\/ad-app-package\/.*$ url reject

# China Merchants Bank splash pre-cache
^https:\/\/mbasecc\.bcs\.cmbchina\.com\/Edge\/api\/mlife\.clientface\.clientservice\.api\.advertiseService\/preCacheAdvertiseSec(?:\?.*)?$ url reject-dict

# Zhaopin splash media
^https://storage-public\.zhaopin\.cn/information/team/public/.*2000x1080.* url reject

# Hunliji startup ad
^https:\/\/api\.hunliji\.com\/hms\/hljLego\/appApi\/startAD\/info(?:\?.*)?$ url reject-dict

# CITIC splash creative by known dimensions
^https?:\/\/autoload\.bank\.ecitic\.com\/imcslego\/cloud\/[^?]+\.(?:png|jpg|jpeg|gif|webp)\?[^#]*(?:width=750&height=1624|height=1624&width=750)(?:&.*)?$ url reject

# China Telecom startup endpoint
^https?:\/\/wapside\.189\.cn(?::\d+)?\/.*(?:splash|advert|advertisement|startup|launch).* url reject-dict

# CTYun wildcard rewrite is quarantined pending an exact-host HAR.

# China Railway 12306 splash. A rejected/404 response leaves the native timeout screen active;
# synthesize a valid, zero-delay ad result instead. Exact ad host only.
^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/railway_12306_splash_clean.js

# Ctrip trip ad endpoint
^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/scjson\/tripAds url reject

hostname = -appgologinhd.189.cn, -appgologin.189.cn, i.video.qq.com, iacc.qq.com, iacc.rec.qq.com, vfiles.gtimg.cn, vip.image.video.qpic.cn, wa.gtimg.com, youtubei.googleapis.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao2.com, api-access.pangolin-sdk-toutiao3.com, api-access.pangolin-sdk-toutiao4.com, api-access.pangolin-sdk-toutiao5.com, api-access.pangolin-sdk-toutiao-b.com, sf3-fe-tos.pglstatp-toutiao.com, sf3-be-pack.pglstatp-toutiao.com, mbasecc.bcs.cmbchina.com, storage-public.zhaopin.cn, api.hunliji.com, autoload.bank.ecitic.com, wapside.189.cn, ad.12306.cn, m.ctrip.com
