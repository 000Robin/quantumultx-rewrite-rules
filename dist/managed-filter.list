#!name=Robin 个人维护去广分流
#!desc=低误杀连接层拦截与关键直连修正；导入时不要设置 force-policy。
#!author=000Robin
#!homepage=https://github.com/000Robin/quantumultx-rewrite-rules
#!date=2026-09-23

# China Telecom login: never intercept or reject certificate-pinned authentication.
host, appgologinhd.189.cn, direct
host, appgologin.189.cn, direct

# Douyin security verification: exact exception only; do not bypass whole domains.
host, vcs-lf.zijieapi.com, direct

# Railway app stability: keep the known service endpoint reachable.
host, ad.12306.cn, direct

# Tencent Video startup/interactive ad connection-layer fallback.
host, iacc.qq.com, reject
host, iacc.rec.qq.com, reject
host, ad.reward.qq.com, reject

# Dongchedi splash-ad package hosts; keep shared ByteDance services reachable.
host, p3-pack.byteimg.com, reject
host, p6-pack.byteimg.com, reject

# UnionPay Cloud QuickPass: exact advertising hosts only.
# Keep wallet/login/payment hosts and shared Getui infrastructure untouched.
host, ads.95516.com, reject
host, tysdk.95516.com, reject
host, ads.cup.com.cn, reject

# China Telecom advertising hosts only.
# Preserve appgologin*.189.cn, wapside.189.cn, e.dlife.cn and open.e.189.cn.
host, ad.21cn.com, reject
host, ad.k.21cn.com, reject
host, admarket.21cn.com, reject
host, adshows.21cn.com, reject

# QQ Music advertising delivery hosts.
# Do not block u6.y.qq.com or shared music/playback/CDN hosts.
host, adstats.tencentmusic.com, reject
host, ad.tencentmusic.com, reject
host, adcdn.tencentmusic.com, reject
host, adcdn6.tencentmusic.com, reject
host, adexpo.tencentmusic.com, reject
host, adclick.tencentmusic.com, reject
host, tmeadcomm.y.qq.com, reject
host, tmead.y.qq.com, reject
