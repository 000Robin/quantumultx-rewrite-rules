# Tencent Video HAR-confirmed iPhone advertising creative only; normal video IDs pass through.
^https:\/\/svv\.video\.qq\.com\/getvinfo(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_creative_block.js

# Tencent Video content-update popup preference; exact binary flag and equal-length value only.
^https:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_request_clean.js

# Tencent Video in-app popup/ad cards; exact root endpoint and explicit binary ad types only.
^https:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_popup_clean.js

