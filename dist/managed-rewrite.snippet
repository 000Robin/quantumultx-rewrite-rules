^https:\/\/wallpaper-1258344696\.file\.myqcloud\.com\/hikari\/template\/(?:10104_20251104195936|10105_20251104195954|10129_20251110144449|10130_20251110144505|10133_20251110154412|10134_20251110154943|10344_20251202154156|10345_20251202154217|10348_20251202184527|10349_20251202184920|10350_20251202185114|10351_20251202185455|10438_20251216161330|11975_20260824194400|11976_20260824194400|11989_20260825185822|11991_20260825192246|11992_20260825192827|11993_20260825192901|12007_20260828161910|12028_20260901164525|12029_20260901164548|12136_20260915201741|12137_20260915201742|12233_20260922200748|12240_20260923113817|12241_20260923113818|12242_20260923113819|12247_20260923113923|12248_20260923113924|12249_20260923113925|12250_20260923113927|12252_20260923113929|12253_20260923113930|12254_20260923113932|12255_20260923113933|12256_20260923113934|12257_20260923113936|12258_20260923113937|12259_20260923113938|12260_20260923113939|12261_20260923113941|12262_20260923113942|12264_20260923120932|12265_20260923121313|12266_20260923121600|12267_20260923121600|12268_20260923121600|12274_20260924110641|12277_20260924145956|12279_20260924164611|12280_20260924164612|12286_20261008160641|12287_20261008160641|1739_20251014150055|1740_20251014150258|1750_20251015142059|1753_20251015144324|1763_20251017094542|1764_20251017094611|1767_20251020220323|1768_20251020220334|674_20241226233407|676_20241227145201|682_20241230110051|684_20241230114518|686_20241230191624|687_20241230191649|72_20240305105256|759_20250114144106|760_20250114144113|762_20250115132550|790_20250121142914|791_20250121143227|795_20250121173555|809_20250210131519|825_20250217171900|868_20250304171719|870_20250305111559|889_20250310165754|933_20250324202453|95_20240403145536|964_20250403165704|96_20240408101023|988_20250427170734|989_20250427170839)\.json(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_hikari_ad_clean.js?v=20261012b
^https:\/\/wallpaper-1258344696\.file\.myqcloud\.com\/hikari\/module\/[^/?]*reward-ad[^/?]*\.zip(?:\?.*)?$ url reject
^https:\/\/wallpaper-1258344696\.file\.myqcloud\.com\/hikari\/template\/\d+_\d{14}\.json(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_hikari_ad_clean.js?v=20261012b

# Tencent Video HAR-confirmed iPhone advertising creative only; normal video IDs pass through.
^https:\/\/svv\.video\.qq\.com\/getvinfo(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_creative_block.js

# Tencent Video content-update popup preference; exact binary flag and equal-length value only.
^https:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-request-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_request_clean.js

# Tencent Video in-app popup/ad cards; exact root endpoint and explicit binary ad types only.
^https:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/tencent_video_popup_clean.js

# Tencent Video pause-ad image confirmed by 2026-08-31 HAR; keep the scope on the ad-exchange CDN path.
^https:\/\/wa\.gtimg\.com\/adxcdn\/.*\.(?:jpe?g|png|gif|webp)(?:\?.*)?$ url reject-img

# Baidu Netdisk splash query/update. Immediately return the service's own valid empty-ad
# structure; keep file, account, membership, thumbnail and upload endpoints untouched.
^https:\/\/afd\.baidu\.com\/afd\/entry\?action=(?:query|update)(?:&.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/baidupan_splash_clean.js

# YouTube ads: exact API host and content endpoints; no googlevideo playback MitM.
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/youtube_ad_clean.js

# Fanqie Novel: Pangle ad manifest/assets plus the user-selected aggressive video mode.
# Video rules intentionally disable chapter video ads and short drama; fq-tts audiobook hosts remain untouched.
^https:\/\/api-access\.pangolin-sdk-toutiao(?:[1-5]|-b)?\.com\/api\/ad\/union\/sdk\/get_ads\/?(?:\?.*)?$ url reject-dict
^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/.*$ url reject
^https:\/\/sf3-be-pack\.pglstatp-toutiao\.com\/obj\/ad-app-package\/.*$ url reject
^https:\/\/v(?:3|5|6|9)-novelapp\.fqnovelvod\.com\/.*\/video\/.*$ url reject
^https:\/\/v(?:3|5|9)-reading-video\.fqnovelvod\.com\/.*$ url reject

# JD splash configuration only. The HAR-confirmed normal functionId=startup
# is intentionally excluded; shared product, image and video services remain reachable.
^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=start(?:&|$).* url reject-array
^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(?:queryMaterialAdverts|home_launchConfig|getWidgetV1052)(?:&|$).* url reject-dict

# China Merchants Bank splash pre-cache
^https:\/\/mbasecc\.bcs\.cmbchina\.com\/Edge\/api\/mlife\.clientface\.clientservice\.api\.advertiseService\/preCacheAdvertiseSec(?:\?.*)?$ url reject-dict

# CIB Life launch-ad list; exact endpoint only because this host also serves core app functions.
^https:\/\/gap\.cibfintech\.com\/entry\/queryLaunchAdListV2(?:\?.*)?$ url reject-dict

# Zhaopin commercial/startup responses observed in the 2026-08-21 HAR. Return valid empty
# payloads instead of 404 so the app does not fall back to a cached splash creative.
^https:\/\/capi\.zhaopin\.com\/capi\/commercialize\/getConfig(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/zhaopin_splash_clean.js
^https:\/\/fe-api\.zhaopin\.com\/experiment\/config\/c\/app(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/zhaopin_splash_clean.js
^https:\/\/cgate\.zhaopin\.com\/bdp\/entrance\/appGrayHomeConfig(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/zhaopin_splash_clean.js
^https:\/\/cgate\.zhaopin\.com\/positionbusiness\/exposure\/extExposureUser(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/zhaopin_splash_clean.js
^https:\/\/cgate\.zhaopin\.com\/operation\/ad\/(?:bidMainPage|getAdRecommend|bidAdvertisingInformation|listMyBannerAd)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/zhaopin_splash_clean.js
^https:\/\/cgate\.zhaopin\.com\/operation\/operationAd\/getJdCardAd(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/zhaopin_splash_clean.js

# Zhaopin splash/large creative fallback; dimensions came from the same verified capture.
^https:\/\/storage-public\.zhaopin\.cn\/information\/team\/public\/.*(?:2000x1080|1080x2000|1290x2796|2796x1290|1179x2556|2556x1179).* url reject

# Hunliji startup ad
^https:\/\/api\.hunliji\.com\/hms\/hljLego\/appApi\/startAD\/info(?:\?.*)?$ url reject-dict

# CITIC splash creative by known dimensions
^https?:\/\/autoload\.bank\.ecitic\.com\/imcslego\/cloud\/[^?]+\.(?:png|jpg|jpeg|gif|webp)\?[^#]*(?:width=750&height=1624|height=1624&width=750)(?:&.*)?$ url reject

# China Telecom startup endpoint
^https?:\/\/wapside\.189\.cn(?::\d+)?\/.*(?:splash|advert|advertisement|startup|launch).* url reject-dict

# CTYun wildcard rewrite is quarantined pending an exact-host HAR.

# China Railway 12306 splash. A rejected/404 response leaves the native timeout screen active;
# synthesize a valid, zero-delay ad result instead. Exact ad host only.
^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/railway_12306_splash_clean.js

# Mengdian e Home splash resource list. Preserve application update packages and remove only image entries.
^https:\/\/mdej\.impc\.com\.cn\/hlwyy\/business-mdej\/sycd\/queryResourcesList(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/mengdian_splash_clean.js

# iScreen launch-ad controls confirmed by 2026-09-15 HAR; keep all content and non-launch ad settings intact.
^https:\/\/cs\.kuso\.xyz\/(?:configs|configs2\/default)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/000Robin/quantumultx-rewrite-rules/main/scripts/iscreen_splash_clean.js

# Ctrip trip ad endpoint
^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/scjson\/tripAds url reject

