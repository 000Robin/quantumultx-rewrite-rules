#!name=Robin Surge 基础分流
#!desc=由仓库 Quantumult X 精确直连与拒绝规则独立转换；不包含 AI 自定义策略。
#!author=000Robin
#!homepage=https://github.com/000Robin/quantumultx-rewrite-rules
#!date=2026-09-18

[Rule]
# China Telecom login and app stability.
DOMAIN,appgologinhd.189.cn,DIRECT
DOMAIN,appgologin.189.cn,DIRECT
DOMAIN,vcs-lf.zijieapi.com,DIRECT
DOMAIN,ad.12306.cn,DIRECT

# Agricultural Bank of China.
DOMAIN-SUFFIX,abchina.com,DIRECT
DOMAIN-SUFFIX,abchina.com.cn,DIRECT
DOMAIN-SUFFIX,95599.cn,DIRECT
DOMAIN-SUFFIX,openaboc.com,DIRECT

# Douyin domestic commerce.
DOMAIN-SUFFIX,ecombdapi.com,DIRECT
DOMAIN-SUFFIX,ecombdimg.com,DIRECT
DOMAIN-SUFFIX,ecombdpage.com,DIRECT
DOMAIN,ecomuser.snssdk.com,DIRECT
DOMAIN,tp-pay.snssdk.com,DIRECT

# Tencent Video startup and interactive advertising.
DOMAIN,iacc.qq.com,REJECT
DOMAIN,iacc.rec.qq.com,REJECT
DOMAIN,ad.reward.qq.com,REJECT

# UnionPay Cloud QuickPass advertising.
DOMAIN,ads.95516.com,REJECT
DOMAIN,tysdk.95516.com,REJECT
DOMAIN,ads.cup.com.cn,REJECT

# China Telecom advertising.
DOMAIN,ad.21cn.com,REJECT
DOMAIN,ad.k.21cn.com,REJECT
DOMAIN,admarket.21cn.com,REJECT
DOMAIN,adshows.21cn.com,REJECT

# QQ Music advertising.
DOMAIN,adstats.tencentmusic.com,REJECT
DOMAIN,ad.tencentmusic.com,REJECT
DOMAIN,adcdn.tencentmusic.com,REJECT
DOMAIN,adcdn6.tencentmusic.com,REJECT
DOMAIN,adexpo.tencentmusic.com,REJECT
DOMAIN,adclick.tencentmusic.com,REJECT
DOMAIN,tmeadcomm.y.qq.com,REJECT
DOMAIN,tmead.y.qq.com,REJECT

[MITM]
# Put exclusions before any broad hostname already present in the main profile.
hostname = %INSERT% -appgologinhd.189.cn, -appgologin.189.cn, -abchina.com, -*.abchina.com, -abchina.com.cn, -*.abchina.com.cn, -95599.cn, -*.95599.cn, -openaboc.com, -*.openaboc.com
